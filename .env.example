# Copy this file to .env and fill in your keys.
# All keys are optional — the project runs fully offline without them.

# Razorpay Test Mode Keys (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Razorpay Payment Link Callback URL
RAZORPAY_CALLBACK_URL=https://razorrevive.demo/callback

# OpenAI API Key (enables LLM diagnosis; falls back to rule engine if absent)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX

# Optional: Override OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Use a custom OpenAI-compatible base URL (e.g. Ollama, Together AI)
# OPENAI_BASE_URL=https://api.openai.com/v1
